# Salin berkas ini menjadi `.env.local` untuk pengembangan lokal.
# JANGAN commit `.env.local` (sudah di-ignore lewat pola `.env*` di .gitignore).
# Di Vercel, isi nilai yang sama lewat Project Settings → Environment Variables
# (bukan lewat file ini).

# --- Supabase (wajib) ---
# Project URL & anon/publishable key: buka project di Supabase Dashboard, klik
# tombol "Connect" (atas halaman) → tab "App Frameworks" → "Next.js" untuk
# menyalin keduanya langsung. Alternatif: sidebar "Project Settings" →
# "API Keys" (Project URL di sana / sub-tab "Data API"; key ada di tab
# "API Keys" [publishable, format sb_publishable_...] atau tab
# "Legacy API Keys" [anon, format JWT eyJ...] — keduanya valid untuk env ini).
# Kedua nilai ini AMAN diekspos ke browser (prefiks NEXT_PUBLIC_) karena akses
# data tetap dibatasi oleh Row Level Security (RLS) di database-schema.sql.
# service_role key JANGAN PERNAH diberi prefiks NEXT_PUBLIC_ (lihat bagian di bawah).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Site URL (opsional, sangat disarankan untuk production) ---
# Dipakai untuk membangun tautan callback reset password yang aman
# (src/lib/auth/actions.ts). Jika kosong, aplikasi memakai header Host dari
# request sebagai fallback (cukup untuk dev, tapi header ini bisa dipalsukan
# klien pada sebagian setup — SELALU set nilai ini di production).
# Isi dengan domain Vercel production kamu, tanpa trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Nomor WhatsApp pemesanan (opsional) ---
# Ditampilkan sebagai tombol "Pesan via WhatsApp" di katalog publik (/katalog).
# Format bebas, mis. 0812-3456-7890 atau 6281234567890. Kosongkan untuk
# menyembunyikan tombol. Dibaca di server saja (tanpa prefiks NEXT_PUBLIC_).
MERAKIT_WHATSAPP_NUMBER=

# --- Instruksi pembayaran Penjualan Online (opsional) ---
# Tampil di halaman status pesanan pembeli (/katalog/pesanan/<token>).
# MERAKIT_PAYMENT_BANK: baris dipisah "|", mis.
#   Bank BJB 0012345678|a.n. Komunitas MERAKIT
# MERAKIT_PAYMENT_QRIS_URL: gambar QRIS statis — taruh berkas di folder public/
#   lalu isi "/qris-merakit.png", atau URL https:// lengkap.
# Bila keduanya kosong, pembeli diberi tahu bahwa admin akan mengirim
# instruksi pembayaran via WhatsApp. Dibaca di server saja.
MERAKIT_PAYMENT_BANK=
MERAKIT_PAYMENT_QRIS_URL=

# --- Service role key (opsional, untuk membuat akun anggota dari aplikasi) ---
# Mengaktifkan tombol "Buat akun baru" dan "Jadikan admin" di halaman detail
# anggota (khusus admin). Supabase Dashboard → Project Settings → API Keys →
# "service_role" / secret key. RAHASIA: melewati RLS dan memberi akses penuh ke
# database. Hanya dibaca di server (src/lib/supabase/admin.ts, paket
# "server-only"); JANGAN beri prefiks NEXT_PUBLIC_, jangan commit, jangan
# bagikan. Isi di Vercel sebagai env "Sensitive" untuk Production saja.
# Kosongkan untuk menonaktifkan fitur (akun tetap bisa dibuat di Supabase).
SUPABASE_SERVICE_ROLE_KEY=

# --- Pembayaran online Midtrans (opsional) ---
# Diadaptasi dari IOM-ITB. Aktif hanya bila MIDTRANS_ENABLED=true, kedua key
# terisi, DAN SUPABASE_SERVICE_ROLE_KEY terisi (hasil bayar ditulis server).
# Key: Midtrans Dashboard → Settings → Access Keys (sandbox dulu untuk uji).
# Isi juga Notification URL di Dashboard → Settings → Payment:
#   https://<domain>/api/midtrans/notification
# MIDTRANS_SERVER_KEY RAHASIA — jangan beri prefiks NEXT_PUBLIC_.
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Opsional: batasi webhook ke IP Midtrans (pisahkan dengan koma).
MIDTRANS_ALLOWED_IPS=

# --- Notifikasi email otomatis (opsional) ---
# SMTP, sama seperti IOM-ITB (Gmail + App Password: Akun Google → Keamanan →
# Verifikasi 2 langkah → Sandi aplikasi). Butuh SUPABASE_SERVICE_ROLE_KEY.
MAIL_USER=
MAIL_PASS=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM_NAME=MERAKIT

# --- Notifikasi WhatsApp otomatis (opsional) ---
# HTTP gateway berformat sama dengan IOM-ITB:
#   POST {WA_API_URL}/api/v1/messages/whatsapp  (Authorization: Bearer WA_API_KEY)
# Minta API key sendiri ke penyedia gateway; jangan pakai key milik IOM.
WA_API_URL=
WA_API_KEY=

# --- Kabar ke admin MERAKIT (opsional) ---
# Pesanan baru, bukti bayar masuk, dan pembayaran online lunas.
ADMIN_NOTIFY_WHATSAPP=
ADMIN_NOTIFY_EMAIL=

# --- Keep-alive Supabase (disarankan di Vercel) ---
# Vercel Cron (vercel.json) memanggil /api/cron/keep-alive tiap hari pukul
# 08.00 WIB supaya project Supabase gratis tidak di-pause karena idle 7 hari.
# Isi dengan string acak panjang (mis. `openssl rand -hex 32`); Vercel otomatis
# mengirimkannya sebagai header Authorization, permintaan lain ditolak.
CRON_SECRET=

# --- Ongkir live kurir (opsional) ---
# Mengikuti IOM-ITB: tarif termurah dari API gratis RajaOngkir (Komerce) dan
# AgenWebsite, dipakai bergiliran agar kuota harian terbagi; bila keduanya
# gagal/kosong, ongkir memakai tabel zona. Butuh SUPABASE_SERVICE_ROLE_KEY
# (tarif live hanya diterima database dari server). Isi salah satu atau keduanya.
#   RajaOngkir: daftar di https://collaborator.komerce.id (paket Starter)
#   AgenWebsite: daftar di https://agenwebsite.com (paket Free)
RAJAONGKIR_API_KEY=
AGENWEBSITE_API_KEY=
# Kode pos asal pengiriman (bawaan 40275 = Binong, Batununggal, Bandung).
SHIPPING_ORIGIN_POSTAL_CODE=40275
# Kurir, pisahkan dengan koma (bawaan jnt). Contoh: jnt,jne,sicepat
SHIPPING_COURIERS=jnt
# Opsional: id asal RajaOngkir agar tidak perlu mencari asal setiap kali.
RAJAONGKIR_ORIGIN_ID=
